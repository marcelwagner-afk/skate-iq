{
  "name": "skate-iq",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SKATE IQ – Performance Intelligence for World Skate Sports (independent product)",
  "scripts": {
    "seed": "esbuild scripts/generate-seed.ts --bundle --platform=node --format=esm --outfile=.tmp/gen-seed.mjs && node .tmp/gen-seed.mjs",
    "import:artistic": "esbuild scripts/import-artistic.ts --bundle --platform=node --format=esm --outfile=.tmp/import-artistic.mjs && node .tmp/import-artistic.mjs",
    "dev": "vite",
    "dev:real": "VITE_REAL=1 vite",
    "build": "tsc --noEmit && vite build",
    "build:real": "tsc --noEmit && VITE_REAL=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  }
}
